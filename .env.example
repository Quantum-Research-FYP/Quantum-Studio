# Server
PORT=3001
NODE_ENV=development

# Database (MongoDB)
# Connection string — use mongodb+srv:// for Atlas or mongodb:// for local
MONGODB_URI=mongodb://localhost:27017/quantum_studio
# Database name (defaults to quantum_studio if not set)
MONGODB_DB_NAME=quantum_studio

# Session
SESSION_SECRET=change-me-to-a-random-secret
SESSION_MAX_AGE_MS=86400000

# Sharing
ENABLE_PUBLIC_SHARING=false

# AI Draft
# Set ENABLE_AI_DRAFTS=true to activate the AI circuit-generation feature.
ENABLE_AI_DRAFTS=false

# AI_PROVIDER — choose one of: mock | anthropic | gemini
#
# mock      No API key needed. Returns a canned circuit (good for dev/testing).
#
# anthropic Calls the Anthropic Claude API.
#           AI_API_KEY  = your Anthropic API key (sk-ant-...)
#           AI_API_URL  = (optional) proxy base URL, defaults to https://api.anthropic.com
#           AI_MODEL    = (optional) defaults to claude-sonnet-4-20250514
#
# gemini    Calls the Google Gemini API (generativelanguage.googleapis.com).
#           AI_API_KEY  = your Google AI Studio API key (AIza...)
#           AI_API_URL  = (optional) proxy base URL, defaults to https://generativelanguage.googleapis.com
#           AI_MODEL    = (optional) defaults to gemini-2.0-flash
#           Get a free key at: https://aistudio.google.com/app/apikey
AI_PROVIDER=mock
AI_API_KEY=
AI_API_URL=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RETAIN_PROMPTS=false

# IBM Quantum Integration
ENABLE_IBM_QUANTUM=false
IBM_QUANTUM_ENCRYPTION_KEY=

# Client (Vite injects these via import.meta.env)
VITE_API_URL=http://localhost:3001
