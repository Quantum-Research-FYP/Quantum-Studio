# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quantum_studio

# Session
SESSION_SECRET=change-me-to-a-random-secret
SESSION_MAX_AGE_MS=86400000

# Sharing
ENABLE_PUBLIC_SHARING=false

# AI Draft
ENABLE_AI_DRAFTS=false
AI_PROVIDER=mock
AI_API_KEY=
AI_API_URL=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RETAIN_PROMPTS=false

# Client (Vite injects these via import.meta.env)
VITE_API_URL=http://localhost:3001
